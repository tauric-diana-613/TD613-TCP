# TD613 server-side Gemini configuration
# Copy to .env.local for local server/proxy development.
# Never commit real API keys.

GEMINI_API_KEY=
GEMINI_ROUTING_MODE=quality-first

# Optional global exact-model override. Blank values use the repository's
# pinned quality-first text order. Avoid moving *-latest aliases in production.
GEMINI_MODEL=
GEMINI_MODEL_FALLBACKS=
GEMINI_DISABLED_MODELS=

# Optional route-specific overrides. Route-specific values take precedence.
HUSH_GEMINI_MODEL=
HUSH_GEMINI_FALLBACKS=
KHONAPOLIT_GEMINI_MODEL=
KHONAPOLIT_GEMINI_FALLBACKS=
# Operator-known aggregate daily request budget for the Marrowline/Kʰonapolit route.
# A provider PerDayPerProjectPerModel receipt is composed across the approved route
# model seats before comparison. Example: 20/model × 5 seats = 100 route requests/day.
KHONAPOLIT_GEMINI_EXPECTED_DAILY_RPD=100

# Loom production uses Vercel's built-in VERCEL_OIDC_TOKEN to reach the
# dedicated Neon custody service. Do not create or copy a Loom DB password or
# signing key into Vercel.
#
# The two variables below are retained only for offline/reference hostile-test
# primitives that exercise the signer and head-store modules directly. They are
# not production Vercel requirements.
TD613_LOOM_DEMO_SIGNING_SECRET=
TD613_LOOM_DEMO_NEON_DATABASE_URL=

# Browser-facing Hush provider posture. The server selects the actual model.
HUSH_REMOTE_PROVIDER=gemini
HUSH_REMOTE_MODEL=auto-quality

# Private TD613 Giving History operator boundary.
# Keep the shared access, HMAC signing, and owner authorities distinct.
# TD613_GIVING_OWNER_SECRET must remain private to the owner; with Neon configured
# it can evict every shared session and lock the shared access secret until reopened.
TD613_GIVING_ACCESS_SECRET=
TD613_GIVING_SESSION_SECRET=
TD613_GIVING_OWNER_SECRET=

# Source and reviewed-write integrations. FEC falls back to DEMO_KEY with a
# much smaller quota; OpenSecrets enriches campaign/organization research only;
# Campaign Deputy is optional until explicit sync is used.
FEC_API_KEY=
OPENSECRETS_API_KEY=
CAMPAIGN_DEPUTY_API_KEY=

# Optional HOSTED/HYBRID ciphertext vault and durable Giving access control.
# LOCAL custody works without Neon, but owner-driven collaborator eviction requires it.
TD613_GIVING_NEON_DATABASE_URL=
