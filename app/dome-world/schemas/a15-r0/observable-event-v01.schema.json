{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "td613.ash.a15-r0.observable-event/v0.1",
  "type": "object",
  "required": [
    "schema",
    "event_id",
    "run_id",
    "projection_id",
    "task_state_before",
    "control_id",
    "control_visible",
    "control_enabled",
    "gesture",
    "action_id",
    "kernel_receipt_id",
    "world_answer_id",
    "action_to_consequence_distance",
    "boundary_crossings",
    "unexplained_seams",
    "backtrack",
    "help_requested",
    "rest_available",
    "return_available",
    "source_status",
    "sensor_id",
    "authority_class",
    "missingness",
    "event_digest"
  ],
  "properties": {
    "schema": { "const": "td613.ash.a15-r0.observable-event/v0.1" },
    "event_id": { "type": "string" },
    "run_id": { "type": "string" },
    "projection_id": { "type": "string" },
    "task_state_before": { "type": "string" },
    "control_id": { "type": "string" },
    "control_visible": { "type": "boolean" },
    "control_enabled": { "type": "boolean" },
    "gesture": { "type": "string" },
    "action_id": { "type": "string" },
    "kernel_receipt_id": { "type": "string" },
    "world_answer_id": { "type": "string" },
    "action_to_consequence_distance": { "type": "integer", "minimum": 0 },
    "boundary_crossings": { "type": "array" },
    "unexplained_seams": { "type": "array" },
    "backtrack": { "type": "boolean" },
    "help_requested": { "type": "boolean" },
    "rest_available": { "type": "boolean" },
    "return_available": { "type": "boolean" },
    "source_status": { "const": "OBSERVED" },
    "sensor_id": { "const": "browser-interface-observation" },
    "authority_class": { "const": "A1_OBSERVATIONAL" },
    "missingness": { "type": "array" },
    "event_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
