{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "td613.ash.a15-r0.open-research-field/v0.2",
  "title": "A15-R0 Open Research Field",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "namespace",
    "source_status",
    "sensor_id",
    "authority_class",
    "production_mutated",
    "external_transmission",
    "human_selection_required",
    "observability",
    "directional_exposure",
    "rank_leakage_non_equivalence",
    "joining_key_synergy",
    "reconstruction",
    "claim_ceiling"
  ],
  "properties": {
    "schema": { "const": "td613.ash.a15-r0.open-research-field/v0.2" },
    "namespace": { "const": "U+10D613" },
    "source_status": { "const": "SIMULATED" },
    "sensor_id": { "const": "deterministic-open-field-model" },
    "authority_class": { "const": "A2_DERIVATIONAL" },
    "production_mutated": { "const": false },
    "external_transmission": { "const": false },
    "human_selection_required": { "const": true },
    "observability": {
      "type": "object",
      "required": [
        "schema",
        "source_status",
        "sensor_id",
        "authority_class",
        "models",
        "null_policy_best_case_information_bits",
        "null_policy_worst_case_information_bits",
        "null_policy_observer_model_gap_bits",
        "observer_family_bounded",
        "finding",
        "universal_zero_defense_claim_supported"
      ],
      "properties": {
        "schema": { "const": "td613.ash.a15-r0.observability-assay/v0.2" },
        "source_status": { "const": "SIMULATED" },
        "sensor_id": { "const": "deterministic-open-field-model" },
        "authority_class": { "const": "A2_DERIVATIONAL" },
        "models": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["model_id", "label", "policy_family", "observer_model", "claim", "mutual_information_bits", "source_status", "authority_class"],
            "properties": {
              "model_id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "policy_family": { "type": "string", "minLength": 1 },
              "observer_model": { "type": "string", "minLength": 1 },
              "claim": { "type": "string", "minLength": 1 },
              "mutual_information_bits": { "type": "number", "minimum": 0 },
              "source_status": { "const": "SIMULATED" },
              "authority_class": { "const": "A2_DERIVATIONAL" }
            }
          }
        },
        "null_policy_best_case_information_bits": { "type": "number", "minimum": 0 },
        "null_policy_worst_case_information_bits": { "type": "number", "minimum": 0 },
        "null_policy_observer_model_gap_bits": { "type": "number", "minimum": 0 },
        "observer_family_bounded": { "const": true },
        "finding": { "type": "string", "minLength": 1 },
        "universal_zero_defense_claim_supported": { "const": false }
      }
    },
    "directional_exposure": {
      "type": "object",
      "required": ["schema", "source_status", "authority_class", "inbound_observable_dimensions", "outbound_disclosed_dimensions", "directional_exposure_ratio", "metric_kind", "shannon_channel_capacity_claim", "finding"],
      "properties": {
        "schema": { "const": "td613.ash.a15-r0.directional-exposure-assay/v0.1" },
        "source_status": { "const": "SIMULATED" },
        "authority_class": { "const": "A2_DERIVATIONAL" },
        "inbound_observable_dimensions": { "type": "integer", "minimum": 0 },
        "outbound_disclosed_dimensions": { "type": "integer", "minimum": 0 },
        "directional_exposure_ratio": { "type": "number", "minimum": 0 },
        "metric_kind": { "const": "declared-dimension-count proxy" },
        "shannon_channel_capacity_claim": { "const": false },
        "finding": { "type": "string", "minLength": 1 }
      }
    },
    "rank_leakage_non_equivalence": {
      "type": "object",
      "required": ["schema", "source_status", "authority_class", "cases", "rank_orders_leakage", "rank_is_secrecy_metric", "finding"],
      "properties": {
        "schema": { "const": "td613.ash.a15-r0.rank-leakage-non-equivalence/v0.1" },
        "source_status": { "const": "SIMULATED" },
        "authority_class": { "const": "A2_DERIVATIONAL" },
        "cases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["case_id", "structural_rank", "mutual_information_bits", "channel_posture"],
            "properties": {
              "case_id": { "type": "string", "minLength": 1 },
              "structural_rank": { "type": "integer", "minimum": 0 },
              "mutual_information_bits": { "type": "number", "minimum": 0 },
              "channel_posture": { "type": "string", "minLength": 1 }
            }
          }
        },
        "rank_orders_leakage": { "const": false },
        "rank_is_secrecy_metric": { "const": false },
        "finding": { "type": "string", "minLength": 1 }
      }
    },
    "joining_key_synergy": {
      "type": "object",
      "required": [
        "schema",
        "source_status",
        "authority_class",
        "construction",
        "feature_a_information_bits",
        "feature_b_information_bits",
        "joint_information_bits",
        "joining_synergy_proxy_bits",
        "positive_joining_synergy",
        "partial_information_decomposition_claim",
        "intrinsic_curvature_claim",
        "finding",
        "caveat"
      ],
      "properties": {
        "schema": { "const": "td613.ash.a15-r0.joining-key-synergy-assay/v0.1" },
        "source_status": { "const": "SIMULATED" },
        "authority_class": { "const": "A2_DERIVATIONAL" },
        "construction": { "const": "balanced XOR fixture" },
        "feature_a_information_bits": { "type": "number", "minimum": 0 },
        "feature_b_information_bits": { "type": "number", "minimum": 0 },
        "joint_information_bits": { "type": "number", "minimum": 0 },
        "joining_synergy_proxy_bits": { "type": "number" },
        "positive_joining_synergy": { "type": "boolean" },
        "partial_information_decomposition_claim": { "const": false },
        "intrinsic_curvature_claim": { "const": false },
        "finding": { "type": "string", "minLength": 1 },
        "caveat": { "type": "string", "minLength": 1 }
      }
    },
    "reconstruction": {
      "type": "object",
      "required": [
        "schema",
        "source_status",
        "sensor_id",
        "authority_class",
        "k",
        "epsilon",
        "subset_count",
        "successful_subsets",
        "reconstructive_redundancy_rho",
        "anisotropic_reconstruction_invariance",
        "anisotropic_reconstruction_floor",
        "worst_case_transform",
        "all_nonidentity_transforms_within_epsilon",
        "transforms",
        "caveat"
      ],
      "properties": {
        "schema": { "const": "td613.ash.a15-r0.reconstruction-assay/v0.2" },
        "source_status": { "const": "SIMULATED" },
        "sensor_id": { "const": "deterministic-open-field-model" },
        "authority_class": { "const": "A2_DERIVATIONAL" },
        "k": { "type": "integer", "minimum": 1 },
        "epsilon": { "type": "number", "minimum": 0, "maximum": 1 },
        "subset_count": { "type": "integer", "minimum": 1 },
        "successful_subsets": { "type": "integer", "minimum": 0 },
        "reconstructive_redundancy_rho": { "type": "number", "minimum": 0, "maximum": 1 },
        "anisotropic_reconstruction_invariance": { "type": "number", "minimum": 0, "maximum": 1 },
        "anisotropic_reconstruction_floor": { "type": "number", "minimum": 0, "maximum": 1 },
        "worst_case_transform": { "type": "string", "minLength": 1 },
        "all_nonidentity_transforms_within_epsilon": { "type": "boolean" },
        "transforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["operator_id", "fragments_remaining", "topology_similarity", "topology_distance", "within_epsilon"],
            "properties": {
              "operator_id": { "type": "string", "minLength": 1 },
              "fragments_remaining": { "type": "integer", "minimum": 0 },
              "topology_similarity": { "type": "number", "minimum": 0, "maximum": 1 },
              "topology_distance": { "type": "number", "minimum": 0, "maximum": 1 },
              "within_epsilon": { "type": "boolean" }
            }
          }
        },
        "caveat": { "type": "string", "minLength": 1 }
      }
    },
    "claim_ceiling": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
