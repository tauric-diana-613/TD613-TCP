    "world_answer": { "type": "string" },
    "owner_receipts": { "type": "array" },
    "observations": { "type": "array" },
    "missingness": { "type": "array" },
    "alternatives": { "type": "array" },
    "open_questions": { "type": "array" },
    "claim_ceiling": { "type": "array" },
    "authority": { "type": "object" },
