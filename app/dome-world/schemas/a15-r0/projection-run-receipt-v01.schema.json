{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "td613.ash.a15-r0.projection-run-receipt/v0.1",
  "type": "object",
  "required": [
    "schema",
    "receipt_id",
    "fixture_id",
    "case_id",
    "action_id",
    "status",
    "created_at",
    "state_before",
    "state_after",
    "source_status",
    "sensor_id",
    "authority_class",
    "world_answer_id",
    "world_answer",
    "owner_receipts",
    "observations",
    "missingness",
    "alternatives",
    "open_questions",
    "claim_ceiling",
    "authority",
    "human_closure_required",
    "receipt_digest"
  ],
  "properties": {
    "schema": { "const": "td613.ash.a15-r0.projection-run-receipt/v0.1" },
    "receipt_id": { "type": "string" },
    "fixture_id": { "type": "string" },
    "case_id": { "type": "string" },
