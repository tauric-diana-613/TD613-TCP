{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://td613.com/encyclopedia/reference/podium/redpen-return.schema.json",
  "title": "TD613 Vixen Podium · Unauthenticated Composer Redpen Return",
  "description": "Review and annotation only. A valid document is NOT an authenticated human Compose approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "score_sha256",
    "source_revision",
    "transport",
    "overall_comment",
    "dispositions",
    "understood",
    "authenticated_human"
  ],
  "properties": {
    "schema": {
      "const": "td613.vixen.podium.redpen-return/v1"
    },
    "score_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "transport": {
      "enum": [
        "REDPEN_JSON_RETURN",
        "IN_CHAT_DECISION_RETURN"
      ]
    },
    "overall_comment": {
      "type": "string",
      "maxLength": 4000
    },
    "understood": {
      "const": "REVIEW_IS_NOT_COMPOSE_AUTHORIZATION"
    },
    "authenticated_human": {
      "const": false
    },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "action",
          "comment",
          "reselect_candidate_id"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "action": {
            "enum": [
              "UNDECIDED",
              "APPROVE",
              "DENY",
              "AMEND",
              "HOLD",
              "REQUEST_ALTERNATIVE",
              "REQUEST_EVIDENCE"
            ]
          },
          "comment": {
            "type": "string",
            "maxLength": 3000
          },
          "reselect_candidate_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          }
        }
      }
    }
  }
}
