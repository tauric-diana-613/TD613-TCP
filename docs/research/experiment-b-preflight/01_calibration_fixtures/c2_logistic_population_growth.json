  },
  "equilibrium_fixed_points": [
    { "N_star": 0.0, "stability": "UNSTABLE" },
    { "N_star": 1000.0, "stability": "ASYMPTOTICALLY_STABLE_ATTRACTOR" }
  ],
  "phase_space_dimension": 1,
  "trajectory_type": "SIGMOIDAL_TIME_EVOLUTION",
  "superficial_terms": ["capacity", "growth_rate", "saturation_limit"]
