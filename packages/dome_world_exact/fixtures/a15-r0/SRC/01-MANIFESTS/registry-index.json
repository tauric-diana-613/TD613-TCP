      "primary_key": "trail_id",
      "schema": "01-MANIFESTS/schemas/coverage-entry.schema.json"
    }
  ],
  "graph_layers": [
    "HISTORICAL",
    "CONCEPTUAL",
    "OPERATIONAL",
    "NAVIGATIONAL",
    "MANIFESTATION",
    "AUTHORITY"
  ],
  "provenance_modes": [
    "explicit-source",
    "archive-observed",
    "archive-inferred",
    "researcher-proposed"
  ],
  "non_collapse_invariants": [
    "work != edition != manifestation != capture",
    "source assertion != archive inference != researcher hypothesis",
    "preservation != authority persistence",
    "theorem label != proof or validation",
    "unavailable != suppressed",
    "ordinal observed + namespace unresolved != numbering error"
  ]
