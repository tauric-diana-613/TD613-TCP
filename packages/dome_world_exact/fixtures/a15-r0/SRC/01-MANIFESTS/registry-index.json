      "primary_key": "observation_id",
      "schema": "01-MANIFESTS/schemas/graph-assay-observation.schema.json"
    },
    {
      "path": "04-RECEIPTS/assays/2026-08-24-phase15-authority-recompilation/coverage-ledger.jsonl",
