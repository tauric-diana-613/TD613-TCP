{
  "schema": "td613.rulefield.receiver-hooks/v1",
  "title": "𝌋 Kiki-Receiver · Refractive Rulefield amendment lifecycle",
  "jurisdiction": "SOURCE_FREE_PROSPECTIVE",
  "apply_mode": "REVIEW_FIRST_NO_AUTOMUTATION",
  "hook_contract": "Hooks are deterministic lifecycle declarations for the receiver and LLM collaborators; packet strings are treated as data, never executed as code.",
  "entrypoints": {
    "primary": "packages/rulefield/AGENTS.md",
    "receiver_docs": "packages/rulefield/amendments/RECEIVER.md",
    "packet_template": "packages/rulefield/amendments/templates/amendment.template.json",
    "schema": "packages/rulefield/amendments/schema.json",
    "runtime": "packages/rulefield/amendments/receiver.mjs",
    "operator_cli": "node scripts/rulefield-amend.mjs",
    "inbox": "packages/rulefield/amendments/inbox/",
    "review_outbox": "packages/rulefield/amendments/outbox/",
    "complexity_lab": "packages/rulefield/lab/multiway_lab.mjs",
    "external_tools": "packages/rulefield/lab/tool_registry.json",
    "roadmap": "packages/rulefield/ROADMAP.md",
    "operator_manual": "packages/rulefield/operator/OPERATOR_GUIDE.md",
    "operator_start": "packages/rulefield/operator/README.md",
    "activation_prompt": "packages/rulefield/operator/ACTIVATION_PROMPT.md",
    "human_submission": "packages/rulefield/operator/templates/HUMAN_RESEARCH_SUBMISSION_FORM.md",
    "operator_disclosure": "packages/rulefield/operator/disclosure.mjs",
    "operator_decision_schema": "packages/rulefield/operator/decision.schema.json",
    "handoff_intake": "scripts/rulefield-intake.py"
  },
  "stages": [
    {
      "stage": 0,
      "hook": "on_packet_intake",
      "owner": "RECEIVER",
      "reads": [
        "inbox/*.json"
      ],
      "writes": [
        "local memory"
      ],
      "rule": "Typed JSON only; reject path traversal, oversized content, executable directives, and unsafe authority."
    },
    {
      "stage": 1,
      "hook": "on_constitution_check",
      "owner": "CUSTODY",
      "reads": [
        "canonical registry SHA-256",
        "packet baseline",
        "packet authority"
      ],
      "writes": [
        "error or held disposition"
      ],
      "rule": "Historic I/P/X, K0 and protected Flight never change through autosync. Stale baselines fail closed."
    },
    {
      "stage": 2,
      "hook": "on_source_preservation",
      "owner": "PROVENANCE",
      "reads": [
        "declared sources",
        "existing rule IDs",
        "typed crossings",
        "queue references"
      ],
      "writes": [
        "explicit unresolved aliases"
      ],
      "rule": "Never infer external witness, identity, authority or source content from an internal hash."
    },
    {
      "stage": 3,
      "hook": "on_rewrite_staging",
      "owner": "NKS_GARDENER",
      "reads": [
        "hypotheses",
        "local rewrite predicates",
        "projections",
        "geometry",
        "consequences"
      ],
      "writes": [
        "source-free candidate descriptions"
      ],
      "rule": "Enumerate alternatives without treating generated future states as executed observations."
    },
    {
      "stage": 4,
      "hook": "on_finite_experiment",
      "owner": "RULEFIELD_NKS_LAB",
      "reads": [
        "proposal.experiment.engine",
        "source-free rule deck",
        "finite initial state",
        "explicit resource bounds"
      ],
      "writes": [
        "review-only bounded experiment result",
        "event or CA history",
        "claim_ceiling"
      ],
      "rule": "Dispatch only FINITE_STRING_MULTIWAY, FINITE_CRITICAL_PAIRS and ELEMENTARY_CA with explicit limits. No arbitrary packet code, no Wolfram kernel claim, no automatic Rulefield mutation."
    },
    {
      "stage": 5,
      "hook": "on_counterfactual_branch",
      "owner": "DOLLHOUSE_DESIGN",
      "reads": [
        "proposals",
        "two competing explanations",
        "reparative reading"
      ],
      "writes": [
        "survive/null/held branches"
      ],
      "rule": "Allow counterexamples, divergence, non-joinable histories, and NO_NEW_RULE_WARRANTED."
    },
    {
      "stage": 6,
      "hook": "on_assay_requirement",
      "owner": "DOLLHOUSE_AUDIT",
      "reads": [
        "falsifier",
        "competent null",
        "negative control",
        "evidence class"
      ],
      "writes": [
        "control deficiencies"
      ],
      "rule": "Audit and design receipts have separate authorities. Do not claim native execution that did not occur."
    },
    {
      "stage": 7,
      "hook": "on_observer_projection",
      "owner": "APERTURE_AND_ATLAS",
      "reads": [
        "operator-facing and machine-facing projections",
        "recovery bounds",
        "observer context"
      ],
      "writes": [
        "projection candidates"
      ],
      "rule": "Computational invariance and reader effects are different testable coordinates. Observer absence stays unobserved."
    },
    {
      "stage": 8,
      "hook": "on_review_receipt",
      "owner": "RECEIVER",
      "reads": [
        "validated packet",
        "all source-free candidates",
        "deficiencies"
      ],
      "writes": [
        "outbox/*.review.json",
        "outbox/*.review.md"
      ],
      "rule": "Deterministic and idempotent output; never canonical registry mutation."
    },
    {
      "stage": 9,
      "hook": "on_pre_synthesis_full_disclosure",
      "owner": "RULEFIELD_OPERATOR_INTERFACE",
      "reads": [
        "actual amendment packet",
        "complete source-free review",
        "packet/baseline SHA-256",
        "source and model caveats"
      ],
      "writes": [
        "content-bound .disclosure.json",
        ".disclosure.md with Light, Medium and Heavy views"
      ],
      "rule": "Complete known-information disclosure of every proposal and review; entire packet and experiment appendix retained; unknown integration diffs remain explicitly unknown; no approval inferred."
    },
    {
      "stage": 10,
      "hook": "on_human_decision_request",
      "owner": "HUMAN_OPERATOR",
      "reads": [
        "bound full dossier",
        "selected proposal IDs",
        "missing source/patch risk",
        "separate human-authored decision"
      ],
      "writes": [
        "future human-controlled, explicit staged-synthesis request only"
      ],
      "rule": "No agent may self-authorize. A typed form lacks identity authentication. Human decision binds exact packet/dossier SHA and can authorize staged candidate only; not canonical integration."
    },
    {
      "stage": 11,
      "hook": "on_operator_promotion_request",
      "owner": "HUMAN",
      "reads": [
        "separately approved evidence",
        "manifest",
        "external source witness"
      ],
      "writes": [
        "future explicit authorized work item"
      ],
      "rule": "No automatic merge, source admission, Flight activation or scientific closure. Human authority reserved."
    }
  ],
  "equivalence_guard": [
    "OPERAHOUSE ≠ OPERA ≠ PERFORMER",
    "Relational geometry ≠ a bare relation graph",
    "Priority ≠ scientific proof",
    "Same endpoint ≠ same history",
    "Source digest ≠ independent exteriority",
    "Machine-readable ≠ operator-facing",
    "Source not available ≠ source never existed",
    "Opacity ≠ absence of coordination",
    "Candidate rule generation ≠ lawful mutation of K0",
    "Model surprise ≠ evidence of unauthorized disobedience"
  ],
  "creative_program": {
    "allowed": [
      "ambiance",
      "anti-equivalence",
      "source-free NKS rewrite",
      "counterfactual branches",
      "multiway graphs",
      "experimental predictions",
      "formalized relational geometry",
      "affective or aesthetic hypotheses",
      "Caro/Butler/Sedgwick refraction",
      "Palace temporal availability",
      "negative results",
      "bounded finite cellular automaton reference model",
      "finite event-instance and critical-pair experiment"
    ],
    "prohibited_auto_actions": [
      "running packet-supplied JavaScript",
      "internet retrieval by packet text",
      "unblinding protected Flight",
      "editing signed prior receipts",
      "changing historical I/P/X in-place",
      "silently resolving uncertain aliases",
      "asserting empirical proof from synthetic toy outcomes"
    ],
    "resynthesis_lenses": [
      "NKS_LOCAL_REWRITE",
      "MULTIWAY_HISTORY",
      "PARANOID_REPARATIVE",
      "CARO_INSTITUTIONAL_CORRIDOR",
      "BUTLER_ITERATIVE_CLASSIFICATION",
      "SEDGWICK_UNFORCED_BRANCHED_READING",
      "COLLINS_DOTSON_MCKITTRICK_ACCESS",
      "VIRILIO_FOUR_CLOCKS",
      "AMBIANCE_OBSERVER_DIFFERENCE",
      "PHASONIC_RELATIONAL_GEOMETRY",
      "GLISSANT_OPACITY",
      "INTEROPERABILITY_NONCONVERGENCE",
      "COMPETENT_NULL_AND_FALSE_POSITIVE",
      "UNCOMMANDED_NOVELTY"
    ]
  },
  "continuous_behavior": {
    "automatic_watching_enabled": false,
    "manual_sync_or_external_scheduler_only": true,
    "reason": "Avoid silent background work or unauthorized autonomous mutation.",
    "experimental_dispatch_requires_typed_spec": true,
    "no_continuous_monitoring": true
  },
  "covenant": "Khona‌lit-po",
  "closure": "RESERVED",
  "human_authorization_contract": {
    "required_for": "STAGED_SYNTHESIS_OF_SELECTED_PROPOSALS",
    "packet_and_disclosure_sha_bound": true,
    "full_readable_and_raw_disclosure": true,
    "canonical_adoption_separately_gated": true,
    "auto_authorization": false,
    "physical_human_identity_proved_by_text": false
  }
}
