{
  "schema": "td613.rulefield.source-locator/v1",
  "date": "2026-11-07",
  "scope": "RESEARCH_DISCOVERY_ROUTES_NOT_AUTOMATIC_ACCESS",
  "rules": [
    "Sources must be searched in actually connected and authorized surfaces only.",
    "A retrieved snippet or saved memory is a lead; cite original source spans and exact revisions.",
    "A source present at old SHA but absent at main is NOT_FOUND_AT_TIP, not NEVER_EXISTED.",
    "Historical PRs, uploads, Library files and live web are separate evidence classes.",
    "Use non-equivalent conceptual aliases for retrieval without presuming identical referents.",
    "A successful job on HEAD A is not execution evidence for HEAD B.",
    "Protected Experiment B source content remains HELD; this locator does not authorize unblinding.",
    "Try alternatives only within the same permission boundary; record inaccessible gaps."
  ],
  "source_surfaces": [
    {
      "id": "GITHUB_REPO",
      "access": "CONNECTED_IF_AVAILABLE",
      "locator": "tauric-diana-613/TD613-TCP",
      "search_modes": [
        "code_search",
        "path_lookup",
        "branches",
        "PR_files",
        "commit_history",
        "immutable_git_show"
      ],
      "witness": [
        "repo",
        "commit",
        "path",
        "blob_sha",
        "lines_or_object_id"
      ]
    },
    {
      "id": "CHAT_UPLOADS",
      "access": "CONVERSATION_SCOPED",
      "search_modes": [
        "filename",
        "semantic",
        "text_read",
        "mounted_file",
        "ZIP_manifest",
        "source_images"
      ],
      "witness": [
        "attachment_id",
        "filename",
        "hash_if_available",
        "source_range"
      ]
    },
    {
      "id": "CHATGPT_LIBRARY",
      "access": "IF_CONNECTED",
      "search_modes": [
        "semantic_search",
        "exact_find",
        "read",
        "materialize",
        "library_folder"
      ],
      "witness": [
        "file_id",
        "version",
        "citation_lines"
      ]
    },
    {
      "id": "HISTORIC_CHAT_AND_CONTEXT",
      "access": "IF_RETRIEVABLE",
      "search_modes": [
        "Remembering_if_available",
        "personal_context",
        "prior_work_summary",
        "source_locator"
      ],
      "witness": [
        "historical_conversation_ref_or_attribution"
      ],
      "warning": "Treat memory as locator, never immutable proof."
    },
    {
      "id": "GIT_HISTORY",
      "access": "REPOSITORY_REVISION_READ",
      "search_modes": [
        "git_log_all",
        "git_show_exact_sha",
        "PR_changed_filenames",
        "test_workflow_logs"
      ],
      "witness": [
        "head",
        "base",
        "status",
        "workflow_run",
        "job_id",
        "method"
      ]
    },
    {
      "id": "ATELIER_SYSTEMS",
      "access": "SOURCE_AND_EXECUTION_GATE",
      "search_modes": [
        "SRC_Atelier",
        "Wendbine_Atelier",
        "EMSTD613_Atelier",
        "Universal_Atelier",
        "source_bundle",
        "search_index",
        "import_witness"
      ],
      "witness": [
        "source_bundle",
        "ingest_receipt",
        "native_runner",
        "query_result"
      ],
      "warning": "Claim source retrieval only after index query returns source content."
    },
    {
      "id": "ENCYCLOPEDIA_AND_DOME",
      "access": "PUBLIC_OR_REPO_AS_PRESENT",
      "search_modes": [
        "reference_records",
        "frontend_script",
        "projection",
        "information_dome",
        "Flow_Core",
        "Manifest",
        "Cupola"
      ],
      "witness": [
        "path",
        "revision",
        "render_witness",
        "runtime_execution"
      ]
    },
    {
      "id": "EXTERNAL_WOLFRAM",
      "access": "PUBLIC_REFERENCE_OPTIONAL_EXECUTION",
      "search_modes": [
        "WolframPhysicsProject",
        "FunctionRepository_MultiwaySystem",
        "WolframModel",
        "Cloud_Notebook"
      ],
      "witness": [
        "function_version",
        "WL_version",
        "notebook",
        "model_parameters",
        "actual_result"
      ],
      "warning": "Public documentation alone has zero execution credit."
    },
    {
      "id": "NETLOGO_COMPLEXITY",
      "access": "PUBLIC_REFERENCE_OPTIONAL_EXECUTION",
      "search_modes": [
        "NetLogo_Web",
        "model_library",
        "SFI_ComplexityExplorer"
      ],
      "witness": [
        "model_source",
        "seed",
        "scheduler",
        "run_receipt"
      ],
      "warning": "Agent-based model simulation is not real-world empirical proof."
    },
    {
      "id": "CLOUD_RESEARCH_SYSTEMS",
      "access": "EXPLICIT_AUTHORIZATION_AND_AVAILABLE_CONNECTOR",
      "search_modes": [
        "GitHub_Actions",
        "Vercel",
        "Neon",
        "Google_Drive",
        "Dropbox",
        "Sharepoint",
        "OneDrive",
        "public_domain"
      ],
      "witness": [
        "source_id",
        "effective_permission",
        "run_identifier",
        "version"
      ],
      "warning": "Do not infer access from a URL or a prior connected tool."
    }
  ],
